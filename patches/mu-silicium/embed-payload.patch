diff --git a/Silicon/Silicium/SiliciumPkg/SiliciumPkg.dec b/Silicon/Silicium/SiliciumPkg/SiliciumPkg.dec
index 6f9dcde..2f3397f 100644
--- a/Silicon/Silicium/SiliciumPkg/SiliciumPkg.dec
