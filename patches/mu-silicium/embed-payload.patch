@@ -14,6 +14,11 @@
   # A Linux-style boot loader passes the physical address of a flattened DT.
   gSiliciumEntryArgHobGuid            = { 0xDAEE82E6, 0x8090, 0x4E72, { 0xBF, 0xB9, 0x78, 0xC1, 0x3C, 0xD4, 0xE3, 0x59 } }
 
+  # HOB holding the embedded payload (address and size) that BootShim placed
+  # right after the firmware volume. The board's RAM-disk driver reads it and
