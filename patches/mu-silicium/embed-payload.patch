+  gSiliciumPayloadHobGuid             = { 0x3E10BF20, 0x8C11, 0x4F6D, { 0xA2, 0x73, 0x1B, 0x94, 0x0E, 0xD6, 0x52, 0x3B } }
+
 [Protocols]
   gKeypadDeviceProtocolGuid           = { 0xA412C1AC, 0x0295, 0x4AE3, { 0xB5, 0x9F, 0x52, 0x23, 0x1F, 0x26, 0x55, 0x4D } }
 
